{
  "name": "al-qarib-gtb",
  "version": "0.1.0",
  "private": true,
  "description": "Al Qarib Corporate Banking / GTB sandbox MVP (Next.js App Router, strict TypeScript, PostgreSQL, installable PWA). Sandbox only: simulated funds, simulated core and rails.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=10.28.0 <11"
  },
  "scripts": {
    "dev": "pnpm pwa:build && next dev",
    "build": "pnpm db:generate && pnpm pwa:build && next build && pnpm build:worker",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start",
    "worker:dev": "tsx --env-file-if-exists=.env worker/index.ts",
    "worker:start": "node --env-file-if-exists=.env dist/worker/index.mjs",
    "pwa:build": "node scripts/build-service-worker.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:contract",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "playwright test",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "db:generate": "prisma generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db-migrate.ts",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env prisma/seed.ts",
    "db:reset-demo": "tsx --conditions=react-server --env-file-if-exists=.env scripts/db-reset-demo.ts",
    "db:local": "bash scripts/dev-postgres.sh",
    "setup:env": "node scripts/setup-env.mjs",
    "openapi:generate": "tsx scripts/openapi-generate.ts",
    "openapi:check": "tsx scripts/openapi-generate.ts --check",
    "worker:status": "tsx --env-file-if-exists=.env scripts/worker-status.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.9",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "better-auth": "1.7.28",
    "bidi-js": "1.1.0",
    "clsx": "2.1.1",
    "csv-parse": "7.0.3",
    "fflate": "0.8.3",
    "ipaddr.js": "2.5.0",
    "libphonenumber-js": "1.13.17",
    "lucide-react": "1.81.0",
    "next": "16.4.6",
    "next-intl": "4.16.2",
    "pdfkit": "0.21.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "saxes": "6.0.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.4",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "fast-check": "4.11.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@node-rs/argon2",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
