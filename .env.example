# Al Qarib GTB sandbox — environment sample.
# Copy to `.env` with `pnpm setup:env` (generates random local secrets) or fill in by hand.
# NEVER commit `.env`. Values below are names and non-secret defaults only.

# --- Mode -------------------------------------------------------------------
# Only `sandbox` is supported in R1. `bank-pilot` / `production` are rejected at startup.
APP_MODE=sandbox
# Only `simulated` exists in R1; any other value fails startup (no real core adapter).
CORE_ADAPTER=simulated
BANK_TIMEZONE=Africa/Tripoli
LOG_LEVEL=info

# --- URLs -------------------------------------------------------------------
# Canonical same-origin URL used for cookie scope, CSRF origin checks and links.
APP_BASE_URL=http://localhost:3000

# --- PostgreSQL (16+) -------------------------------------------------------
# Runtime connection for the app and worker: least privilege (no DDL, append-only audit).
DATABASE_URL=postgresql://alqarib_app:CHANGE_ME@127.0.0.1:5432/alqarib_dev
# Schema-owner connection used ONLY by `pnpm db:migrate` / `pnpm db:seed` grants.
MIGRATION_DATABASE_URL=postgresql://alqarib_owner:CHANGE_ME@127.0.0.1:5432/alqarib_dev
# Superuser-capable URL used only by `pnpm db:local` and the integration-test harness to
# create roles/databases. With a local cluster and peer auth this can stay empty.
# POSTGRES_ADMIN_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres

# --- Secrets (generate, never reuse the sample) -----------------------------
# Session signing/encryption secret for the authentication library (>= 32 random bytes).
AUTH_SECRET=CHANGE_ME_GENERATE_WITH_pnpm_setup_env
# 32-byte base64 key for encrypting stored webhook signing secrets. Separate from AUTH_SECRET.
DATA_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_pnpm_setup_env

# --- Private storage --------------------------------------------------------
# Uploads and generated reports/receipts. Must be outside the public web root.
STORAGE_PATH=./storage

# --- Synthetic demo seed (sandbox only) -------------------------------------
# Explicit opt-in; the seed refuses to run unless APP_MODE=sandbox and this is `true`.
SEED_DEMO_ENABLED=true
# Password given to every synthetic demo identity. Generated locally by `pnpm setup:env`;
# it is not a shipped default and demo identities cannot exist outside sandbox mode.
DEMO_PASSWORD=CHANGE_ME_GENERATE_WITH_pnpm_setup_env

# --- Sandbox-only test controls ---------------------------------------------
# Allows a webhook destination on this exact host:port for the local fixture receiver used
# by tests (e.g. 127.0.0.1:4010). Leave empty otherwise; private addresses are always blocked.
WEBHOOK_TEST_RECEIVER_ALLOWLIST=

# --- Worker and execution tuning (optional; defaults shown) --------------------
# WORKER_POLL_MS=500            # idle wait between queue polls
# WORKER_LEASE_MS=60000         # job lease; a crashed worker's job is re-claimed after it
# WORKER_CONCURRENCY=5          # jobs in flight per worker process
# WORKER_MAINTENANCE_MS=15000   # interval of idempotent housekeeping sweeps
# AUTO_INQUIRY_DELAY_SECONDS=60 # wait before the first automatic inquiry of an unknown outcome
# AUTO_INQUIRY_MAX_ATTEMPTS=5   # automatic inquiries before operations must act (never a blind retry)
# APPROVAL_VALIDITY_DAYS=7      # how long a proposal may wait for votes
# SETTLEMENT_POLL_SECONDS=5     # rail settlement polling interval
# ROW_CONCURRENCY=5             # bounded concurrency for batch row dispatch

# --- Tooling ------------------------------------------------------------------
# Next.js anonymous telemetry is disabled: this project makes no external calls.
NEXT_TELEMETRY_DISABLED=1
